{
  "pluginAlias": "EurekaE20",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Eureka E20 Plus",
        "required": true
      },
      "email": {
        "title": "Eureka app email",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "Eureka app password",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "password"
        }
      },
      "pollSeconds": {
        "title": "Status check interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 15,
        "maximum": 300
      },
      "matterVacuum": {
        "title": "Show as a vacuum in Apple Home (needs Matter enabled in Homebridge and iOS 18.4 or later)",
        "type": "boolean",
        "default": true
      },
      "switches": {
        "title": "Clean and Pause switches",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "Auto (on only when the vacuum tile is not shown)",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "On",
            "enum": [
              "on"
            ]
          },
          {
            "title": "Off",
            "enum": [
              "off"
            ]
          }
        ]
      },
      "cleanModes": {
        "title": "Offer Vacuum and Vacuum and mop on the vacuum tile",
        "type": "boolean",
        "default": true
      },
      "mopWater": {
        "title": "Mop water level used for Vacuum and mop",
        "type": "integer",
        "default": 2,
        "minimum": 1,
        "maximum": 3
      }
    }
  }
}
